# STT 서버 주소·포트 설정. 이 파일을 같은 폴더에 .env 로 복사한 뒤 값만 고침 (.env는 깃에 올라가지 않음)
#   윈도우: copy .env.example .env     맥: cp .env.example .env
# 값을 정하는 순서: 명령 옵션 > 환경 변수 > .env > 기본값. 비워 두면 기본값을 씀

# 전사를 보낼 백엔드 주소. 비우면 보내지 않고 transcripts/의 .backend.jsonl 파일에만 기록
# 가짜 백엔드로 시험: http://127.0.0.1:8767   정식 서버에 붙일 때: 그 백엔드 주소 (예: http://meeting-service:8080)
BACKEND_URL=

# 접속을 받는 범위. 127.0.0.1 = 이 컴퓨터에서만 (기본), 0.0.0.0 = 네트워크로 들어오는 접속 모두
# STT_HOST: 확인용 화면(STT_PORT, 개발 화면·/sender)을 누가 열 수 있는지. 0.0.0.0이면 전사 화면도 네트워크에 열림
# WS_HOST:  소리를 받는 WebSocket(WS_PORT)에 누가 붙을 수 있는지. 서버·컨테이너에 올려 Gateway·다른 PC 브라우저에서 받을 때 0.0.0.0
# 정식 서비스 예: WS_HOST=0.0.0.0, STT_HOST=127.0.0.1 (소리 통로만 열고 개발 화면은 숨김)
# 브라우저 마이크는 localhost가 아니면 https에서만 켜짐
STT_HOST=127.0.0.1
WS_HOST=127.0.0.1

# 포트. 이미 쓰는 포트면 바꿈
STT_PORT=8765
WS_PORT=8770
MOCK_PORT=8767

# 모델 폴더. 비우면 prototype/models (tools/download_models.py가 받는 곳)
NINEOUTING_STT_MODELS=
