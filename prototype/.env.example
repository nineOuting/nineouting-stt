# STT 서버 주소·포트 설정. 이 파일을 같은 폴더에 .env 로 복사한 뒤 값만 고침 (.env는 깃에 올라가지 않음)
#   윈도우: copy .env.example .env     맥: cp .env.example .env
# 값을 정하는 순서: 명령 옵션 > 환경 변수 > .env > 기본값. 비워 두면 기본값을 씀

# 전사를 보낼 백엔드 주소. 비우면 보내지 않고 transcripts/의 .backend.jsonl 파일에만 기록
# 가짜 백엔드로 시험: http://127.0.0.1:8767   정식 서버에 붙일 때: 그 백엔드 주소 (예: http://meeting-service:8080)
BACKEND_URL=

# 접속을 받는 범위. 127.0.0.1 = 이 컴퓨터에서만 (기본), 0.0.0.0 = 네트워크로 들어오는 접속 모두
# STT_HOST: 확인용 화면(STT_PORT, 개발 화면·/sender)을 누가 열 수 있는지. 0.0.0.0이면 전사 화면도 네트워크에 열림
# WS_HOST:  소리를 받는 WebSocket(WS_PORT)에 누가 붙을 수 있는지. 서버·컨테이너에 올려 Gateway·다른 PC 브라우저에서 받을 때 0.0.0.0
# 정식 서비스 예: WS_HOST=0.0.0.0, STT_HOST=127.0.0.1 (소리 통로만 열고 개발 화면은 숨김)
# 브라우저 마이크는 localhost가 아니면 https에서만 켜짐
STT_HOST=127.0.0.1
WS_HOST=127.0.0.1

# 포트. 이미 쓰는 포트면 바꿈
STT_PORT=8765
WS_PORT=8770
MOCK_PORT=8767

# --input ws: 동시에 여는 회의 수 상한. 다 차면 새 회의 연결은 1013으로 닫음 (/ready는 그대로 200, 기본 4)
#   0이면 상한 없음 (시험용. CPU가 모자라면 모든 회의의 자막이 같이 늦어짐)
MAX_MEETINGS=
# --input ws: 회의의 밀린 소리가 이 초를 넘으면 로그에 남김 (기본 5, 0이면 끔)
BACKLOG_WARN_SEC=
# --input ws: 연결이 끊긴 회의를 정리하기까지 기다리는 초 (기본 600). 정리할 때 end 알림은 보내지 않음
MEETING_IDLE_SEC=
# --input ws: 한 회의의 연결이 REPLACE_WINDOW_SEC초(기본 60) 안에 REPLACE_MAX번(기본 5) 바뀌었으면 새 연결을 4002로 닫고 지금 연결을 지킴
#   같은 회의를 연 창 둘이 서로 밀어내기를 반복하지 않게 함. REPLACE_MAX=0이면 끔
REPLACE_MAX=
REPLACE_WINDOW_SEC=
# --input ws: 꽉 차거나 밀리면 /ready를 503으로 냄 (1이면 켬, 기본 꺼짐). 파드가 2대 이상이고 ALB 쿠키 고정을 쓸 때만 켬
#   파드가 1대일 때 켜면 ALB에 갈 곳이 없어 진행 중인 회의의 다시 연결까지 막힘 (SCRUM-337)
READY_WHEN_FULL=
# 위가 켜졌을 때: 어느 회의든 밀린 소리가 이 초를 넘고 실시간보다 느리게 처리하면 밀림 (기본 5)
READY_BACKLOG_SEC=
# 위가 켜졌을 때: 꽉 찬 뒤 이만큼 자리가 비어야 다시 받음 (기본 1)
READY_MARGIN=

# 모델 폴더. 비우면 prototype/models (tools/download_models.py가 받는 곳)
NINEOUTING_STT_MODELS=
